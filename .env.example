# SAHIIXX REA Worker — configuration reference (placeholders only).
# The deploy script does not source this file, .env, .env.local, or .dev.vars.
# Wrangler itself may read .env for CLI credentials; runtime secret values for
# this script must still be explicitly exported or entered at its prompts.
# Export the appropriate values in your shell, or answer its interactive prompts:
#   bash deployment/deploy.sh
# It runs npm ci using the committed lockfile and the locally installed Wrangler.
# Deployment targets the DEFAULT wrangler.toml configuration, which is production.
# There is no [env.production]; do not add --env production to these commands.

# Deployment credentials: consumed by Wrangler, NOT Worker runtime bindings.
# Optional locally when already logged in; otherwise the script offers login.
# Noninteractive deployment needs an API token or an existing Wrangler session.
# Token access must cover the chosen account's Workers, R2, KV, and Queues
# provisioning/deployment operations (and listing those resources).
CLOUDFLARE_API_TOKEN="<cloudflare-api-token>"
CLOUDFLARE_ACCOUNT_ID="<cloudflare-account-id>"

# Health target: exported WORKER_URL or an interactive URL after deploy.
# Accepts the real deployed origin or its /health URL. Required noninteractively.
# A failed/missing check is not reported as a live, healthy deployment.
WORKER_URL="https://<worker-name>.<account-subdomain>.workers.dev"

# Worker runtime secrets: exported values are uploaded by deployment/deploy.sh
# via local Wrangler secret put. Required values are prompted for if interactive.
# BUS_WEBHOOK_URL must be the actual bus ingestion endpoint, including its path.
BUS_WEBHOOK_URL="https://<bus-host>/<ingestion-path>"
# Use the SAME signing secret that the bus verifies. Generate a random secret
# locally (for example: openssl rand -hex 32) and coordinate it with the bus.
PROXY_JWT_SECRET="<shared-bus-jwt-signing-secret>"
# Optional memory service endpoint. Leave unset/blank to skip uploading it;
# this keeps any existing remote TITANS_MEMORY_URL secret, rather than deleting it.
TITANS_MEMORY_URL=""

# GitHub Actions vs Worker secrets:
# Configure CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID as GitHub repository
# Actions secrets for CI. WORKER_URL may be a CI variable/secret for health checks.
# A workflow must explicitly map them into its environment/action inputs.
# GitHub secrets alone DO NOT create Worker runtime secrets. BUS_WEBHOOK_URL,
# PROXY_JWT_SECRET, and optional TITANS_MEMORY_URL belong in the Worker's secret
# store. Provision them with this script or node_modules/.bin/wrangler secret put
# <KEY> before deploying through a workflow that only runs wrangler deploy.
# For noninteractive use of this script, explicitly map the runtime secret values
# into its environment as well. Never upload the Cloudflare API token as a Worker
# secret. Never commit a filled-in copy of this template.

# Local development with Wrangler 3:
# Create .dev.vars at the repository root (already gitignored) containing ONLY
# the Worker runtime keys needed locally, using the same KEY="value" format.
# Fill in local bus/memory endpoints and a local-only JWT secret. Then run:
#   node_modules/.bin/wrangler dev --local
# Wrangler dev reads .dev.vars; it is NOT uploaded by wrangler deploy/secret put.
# Plain shell exports or .env.local are not automatically Worker bindings in
# Wrangler 3. Do not copy Cloudflare deployment credentials into .dev.vars.
# Nonsecret Worker settings and R2/KV/queue names live in wrangler.toml.
