{
  "name": "sahiixx-rea-worker",
  "version": "1.0.0",
  "description": "SAHIIXX REA OS - Edge-native Reverse Engineer Anything",
  "main": "src/index.ts",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy",
    "deploy:script": "bash deployment/deploy.sh",
    "tail": "wrangler tail",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tooling": "node --test --test-concurrency=1 scripts/*.check.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/validate-evidence.mjs",
    "validate": "node scripts/validate-evidence.mjs",
    "smoke:e2e": "node scripts/e2e-smoke.mjs",
    "bus:local": "node scripts/local-bus.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241015.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  }
}
